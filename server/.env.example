PORT=5000
NODE_ENV=development
MONGO_URI=xxxx

# Database name. Defaults to SnipeAndBite, so data never lands in the "test" database.
MONGO_DB_NAME=SnipeAndBite
JWT_SECRET=xxxx

# Key used to encrypt two-factor secrets at rest. Use a different random value from JWT_SECRET.
TWO_FACTOR_ENCRYPTION_KEY=xxxx

# Comma separated list of allowed frontend URLs
CLIENT_URL=http://localhost:5173

# Every sign-in lasts 9 hours. Without Remember Me, already-open tabs can share the temporary login; closing the last app tab ends it.
# Optional inactivity timeout in minutes (0 or empty disables it)
SESSION_IDLE_MINUTES=0

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# Email (optional). Without these, order and password reset emails are skipped.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=xxxx
EMAIL_PASS=xxxx
EMAIL_FROM_NAME=Snipe&Bite

# Razorpay (optional). Without these, only Cash on Delivery is offered.
RAZORPAY_KEY_ID=xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx

# Used once by: npm run seed:super-admin. Remove SUPER_ADMIN_PASSWORD afterwards.
SUPER_ADMIN_NAME=xxxx
SUPER_ADMIN_EMAIL=xxxx
SUPER_ADMIN_PASSWORD=xxxx

# Every contact form message is also emailed to this address.
CONTACT_NOTIFY_EMAIL=xxxx

# Public URL of THIS backend, no trailing slash. Used to build OAuth callback URLs.
BACKEND_URL=http://localhost:5000

# ---- Social sign-in (each provider appears on the login page only when ALL its values are set) ----
# Google:   https://console.cloud.google.com  > APIs and Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=xxxx
GOOGLE_CLIENT_SECRET=xxxx

# GitHub:   https://github.com/settings/developers > OAuth Apps > New OAuth App
GITHUB_CLIENT_ID=xxxx
GITHUB_CLIENT_SECRET=xxxx

# Facebook: https://developers.facebook.com/apps > Create app > Facebook Login
FACEBOOK_APP_ID=xxxx
FACEBOOK_APP_SECRET=xxxx

# LinkedIn: https://www.linkedin.com/developers/apps > Create app > Products > "Sign In with LinkedIn using OpenID Connect".
#   Auth tab: copy the Client ID and Client Secret, and add the redirect URL <BACKEND_URL>/api/auth/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=xxxx
LINKEDIN_CLIENT_SECRET=xxxx
